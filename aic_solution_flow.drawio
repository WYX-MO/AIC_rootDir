        <!-- ===== 标题 ===== -->
        <mxCell id="6" value="复赛方案&#xa;实现流程图&#xa;（中文标注）" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="360" height="90" as="geometry" />
        </mxCell>

        <!-- ===== 输入 ===== -->
        <mxCell id="2" value="输入：赛方测试集（426 条）&#xa;video/&lt;id&gt;.mp4 + jsonl/&lt;id&gt;.jsonl&#xa;（声明 targetRatioWH）" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="40" width="420" height="90" as="geometry" />
        </mxCell>

        <!-- ===== 支路 A ===== -->
        <mxCell id="10" value="① 逐帧保留（τ=1）&#xa;丢弃末 8% 帧" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="3">
          <mxGeometry x="60" y="60" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="11" value="② 由 targetRatioWH 与源分辨率算 crop_size&#xa;→ 居中裁剪框" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="3">
